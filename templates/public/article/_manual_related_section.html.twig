{% if manualRelatedArticles is defined and manualRelatedArticles is not empty %}
<section class="article-section-block article-manual-related-section">
    <p class="section-label">Relacionadas</p>
    <div class="manual-related-grid">
        {% for item in manualRelatedArticles %}
            <article class="manual-related-card">
                <a href="{{ path('public_article_show', {slug: item.slug}) }}" class="manual-related-media">
                    {% set img = article_usable_featured(item) %}
                    {% if img %}
                        {{ seo_article_image(img, item.title) }}
                    {% else %}
                        <span class="story-card-media-placeholder" aria-hidden="true">{{ site.name|default('') }}</span>
                    {% endif %}
                </a>
                <div class="manual-related-body">
                    {% if item.category %}
                        <a href="{{ path('public_category_show', {slug: item.category.slug}) }}" class="cat-pill cat-pill--muted">{{ item.category.name }}</a>
                    {% endif %}
                    <h3><a href="{{ path('public_article_show', {slug: item.slug}) }}">{{ item.title }}</a></h3>
                    {% set excerpt = item.lead ?: item.subtitle %}
                    {% if excerpt %}
                        <p>{{ excerpt|length > 110 ? excerpt|slice(0, 107) ~ '…' : excerpt }}</p>
                    {% endif %}
                </div>
            </article>
        {% endfor %}
    </div>
</section>
{% endif %}
