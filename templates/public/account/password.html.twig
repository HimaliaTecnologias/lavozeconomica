{% extends 'public/account/_layout.html.twig' %}
{% set accountPageTitle = 'Cambiar contraseña' %}

{% block account_content %}
<h2>Cambiar contraseña</h2>

<form method="post" class="account-form" novalidate style="max-width:420px">
    <input type="hidden" name="_token" value="{{ csrf_token('account_password') }}">

    <div class="account-field">
        <label for="current_password">Contraseña actual</label>
        <input type="password" id="current_password" name="current_password" autocomplete="current-password"
               class="{{ errors.current_password is defined ? 'is-error' : '' }}" required>
        {% if errors.current_password is defined %}<div class="error-msg">{{ errors.current_password }}</div>{% endif %}
    </div>

    <div class="account-field">
        <label for="new_password">Nueva contraseña</label>
        <input type="password" id="new_password" name="new_password" autocomplete="new-password"
               class="{{ errors.new_password is defined ? 'is-error' : '' }}" required minlength="8">
        {% if errors.new_password is defined %}<div class="error-msg">{{ errors.new_password }}</div>{% endif %}
    </div>

    <div class="account-field">
        <label for="confirm_password">Confirmar nueva contraseña</label>
        <input type="password" id="confirm_password" name="confirm_password" autocomplete="new-password"
               class="{{ errors.confirm_password is defined ? 'is-error' : '' }}" required minlength="8">
        {% if errors.confirm_password is defined %}<div class="error-msg">{{ errors.confirm_password }}</div>{% endif %}
    </div>

    <button type="submit" class="account-submit">Actualizar contraseña</button>
</form>
{% endblock %}
