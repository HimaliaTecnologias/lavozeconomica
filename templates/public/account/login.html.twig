{% extends 'public/layout.html.twig' %}

{% block title %}Iniciar sesión — {{ site.name }}{% endblock %}

{% block body %}
<div class="archive-layout account-auth-layout">
    <div class="archive-main">
        <div class="account-page account-page--auth">
            {% include 'public/account/_breadcrumb.html.twig' with {
                showAccountRoot: false,
                breadcrumbCurrent: 'Iniciar sesión',
            } only %}

            <header class="account-page-head account-page-head--auth">
                <div>
                    <h1>Iniciar sesión</h1>
                    <p class="account-page-lead">Accede para comentar y valorar noticias en {{ site.name }}.</p>
                </div>
            </header>

            {% include 'public/_partials/ad_slot.html.twig' with { placement: 'category_sidebar' } only %}

            <div class="account-card">
                {% if error %}
                    <div class="account-alert" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <form method="post" action="{{ path('login_check') }}" class="account-form">
                    <div class="account-form-fields">
                        <div class="account-field">
                            <label for="email">Correo</label>
                            <input type="email" id="email" name="_username" value="{{ last_username }}" required autofocus autocomplete="username">
                        </div>
                        <div class="account-field">
                            <label for="password">Contraseña</label>
                            <input type="password" id="password" name="_password" required autocomplete="current-password">
                        </div>
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button type="submit" class="account-submit">Entrar</button>
                </form>

                <p class="account-footer-link">¿No tienes cuenta? <a href="{{ path('cuenta_register') }}">Regístrate</a></p>
                <p class="account-footer-link"><a href="{{ path('admin_login') }}">Acceso al panel editorial</a></p>
            </div>
        </div>
    </div>

    {% if sidebarArticles is defined and sidebarArticles is not empty %}
        <aside class="article-sidebar">
            {% include 'public/_partials/ad_slot.html.twig' with { placement: 'sidebar_top' } only %}
            <div class="sidebar-block">
                <p class="sidebar-label">Lo último</p>
                <div class="sidebar-list">
                    {% for article in sidebarArticles %}
                        {% include 'public/_partials/sidebar_story.html.twig' with { article: article } %}
                    {% endfor %}
                </div>
            </div>
            {% include 'public/_partials/sidebar_links.html.twig' %}
        </aside>
    {% endif %}
</div>
{% endblock %}
