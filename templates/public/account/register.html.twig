{% extends 'public/layout.html.twig' %}

{% block title %}Crear cuenta — {{ site.name }}{% endblock %}

{% block body %}
<div class="archive-layout account-auth-layout">
    <div class="archive-main">
        <div class="account-page account-page--auth">
            {% include 'public/account/_breadcrumb.html.twig' with {
                showAccountRoot: false,
                breadcrumbCurrent: 'Crear cuenta',
            } only %}

            <header class="account-page-head account-page-head--auth">
                <div>
                    <h1>Crear cuenta</h1>
                    <p class="account-page-lead">Regístrate para participar en {{ site.name }}: comentar y valorar noticias. Deberás confirmar tu correo antes de entrar.</p>
                </div>
            </header>

            {% include 'public/_partials/ad_slot.html.twig' with { placement: 'category_sidebar' } only %}

            <div class="account-card">
                {% if errors.general is defined %}
                    <div class="account-alert" role="alert">{{ errors.general }}</div>
                {% endif %}

                <form method="post" class="account-form" novalidate>
                    <input type="hidden" name="_token" value="{{ csrf_token('register') }}">
                    <input type="text" name="website" value="" class="account-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">

                    <div class="account-form-fields">
                        <div class="account-field">
                            <label for="email">Correo *</label>
                            <input type="email" id="email" name="email" required
                                   value="{{ formData.email|default('') }}"
                                   class="{{ errors.email is defined ? 'is-error' : '' }}">
                            {% if errors.email is defined %}<span class="field-error">{{ errors.email }}</span>{% endif %}
                        </div>

                        <div class="account-field">
                            <label for="name">Nombre *</label>
                            <input type="text" id="name" name="name" required
                                   value="{{ formData.name|default('') }}"
                                   class="{{ errors.name is defined ? 'is-error' : '' }}">
                            {% if errors.name is defined %}<span class="field-error">{{ errors.name }}</span>{% endif %}
                        </div>
                    </div>

                    <div class="account-field">
                        <label for="password">Contraseña *</label>
                        <input type="password" id="password" name="password" required minlength="8"
                               class="{{ errors.password is defined ? 'is-error' : '' }}">
                        {% if errors.password is defined %}<span class="field-error">{{ errors.password }}</span>{% endif %}
                        <span class="field-hint">Mínimo 8 caracteres.</span>
                    </div>

                    {% if usesRecaptcha %}
                        <div class="account-field account-captcha">
                            <label>Verificación anti-spam *</label>
                            <div class="g-recaptcha" data-sitekey="{{ recaptchaSiteKey }}"></div>
                            {% if errors.captcha is defined %}<span class="field-error">{{ errors.captcha }}</span>{% endif %}
                        </div>
                    {% elseif captchaChallenge %}
                        <div class="account-field account-captcha">
                            <label for="captcha_answer">Verificación anti-spam *</label>
                            <p class="captcha-question">¿Cuánto es {{ captchaChallenge.question }}?</p>
                            <input type="text" id="captcha_answer" name="captcha_answer" required
                                   inputmode="numeric" autocomplete="off"
                                   class="{{ errors.captcha is defined ? 'is-error' : '' }}">
                            {% if errors.captcha is defined %}<span class="field-error">{{ errors.captcha }}</span>{% endif %}
                        </div>
                    {% endif %}

                    <button type="submit" class="account-submit">Crear cuenta</button>
                </form>

                <p class="account-footer-link">¿Ya tienes cuenta? <a href="{{ path('cuenta_login') }}">Inicia sesión</a></p>
            </div>
        </div>
    </div>

    {% if sidebarArticles is defined and sidebarArticles is not empty %}
        <aside class="article-sidebar">
            {% include 'public/_partials/ad_slot.html.twig' with { placement: 'sidebar_top' } only %}
            <div class="sidebar-block">
                <p class="sidebar-label">Lo último</p>
                <div class="sidebar-list">
                    {% for article in sidebarArticles %}
                        {% include 'public/_partials/sidebar_story.html.twig' with { article: article } %}
                    {% endfor %}
                </div>
            </div>
            {% include 'public/_partials/sidebar_links.html.twig' %}
        </aside>
    {% endif %}
</div>
{% endblock %}

{% block extra_scripts %}
{% if usesRecaptcha %}
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
{% endif %}
{% endblock %}
