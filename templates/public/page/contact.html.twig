{% extends 'public/layout.html.twig' %}

{% block title %}{{ pageTitle }} — {{ site.name }}{% endblock %}

{% block body %}
<div class="archive-layout">
    <div class="archive-main static-page contact-page">
        <nav class="article-breadcrumb">
            <a href="{{ path('home') }}">Portada</a> · {{ pageTitle }}
        </nav>
        <h1 class="static-page-title">{{ pageTitle }}</h1>

        {% if bodyHtml %}
            <div class="static-page-content article-content contact-page-intro">
                {{ bodyHtml|seo_enrich_html(pageTitle)|raw }}
            </div>
        {% endif %}

        <section class="contact-form-panel" aria-labelledby="contact-form-title">
            <h2 id="contact-form-title" class="contact-form-title">Envíanos un mensaje</h2>
            <p class="contact-form-hint">Responderemos a tu consulta en el menor tiempo posible.</p>

            <form method="post" action="{{ path('public_contact_submit') }}" class="contact-form">
                <input type="hidden" name="_token" value="{{ csrf_token('contact_form') }}">
                <div class="newsletter-honeypot" aria-hidden="true">
                    <label for="contact-website">No rellenar</label>
                    <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off">
                </div>

                <div class="contact-form-grid">
                    <div class="field">
                        <label for="contact-name">Nombre</label>
                        <input
                            type="text"
                            id="contact-name"
                            name="name"
                            required
                            maxlength="120"
                            value="{{ contactFormData.name|default('') }}"
                            class="{{ contactFormErrors.name is defined ? 'error' : '' }}"
                        >
                        {% if contactFormErrors.name is defined %}
                            <div class="field-error">{{ contactFormErrors.name }}</div>
                        {% endif %}
                    </div>
                    <div class="field">
                        <label for="contact-email">Email</label>
                        <input
                            type="email"
                            id="contact-email"
                            name="email"
                            required
                            maxlength="180"
                            value="{{ contactFormData.email|default('') }}"
                            class="{{ contactFormErrors.email is defined ? 'error' : '' }}"
                        >
                        {% if contactFormErrors.email is defined %}
                            <div class="field-error">{{ contactFormErrors.email }}</div>
                        {% endif %}
                    </div>
                </div>

                <div class="field">
                    <label for="contact-subject">Asunto <span class="field-optional">(opcional)</span></label>
                    <input
                        type="text"
                        id="contact-subject"
                        name="subject"
                        maxlength="160"
                        value="{{ contactFormData.subject|default('') }}"
                    >
                </div>

                <div class="field">
                    <label for="contact-message">Mensaje</label>
                    <textarea
                        id="contact-message"
                        name="message"
                        rows="7"
                        required
                        maxlength="5000"
                        class="{{ contactFormErrors.message is defined ? 'error' : '' }}"
                    >{{ contactFormData.message|default('') }}</textarea>
                    {% if contactFormErrors.message is defined %}
                        <div class="field-error">{{ contactFormErrors.message }}</div>
                    {% endif %}
                </div>

                <div class="contact-form-legal">
                    <label class="contact-form-legal-check">
                        <input
                            type="checkbox"
                            name="privacy_accept"
                            value="1"
                            required
                            class="{{ contactFormErrors.privacy_accept is defined ? 'error' : '' }}"
                        >
                        <span>
                            He leído y acepto el
                            <a href="{{ path('public_page_show', {slug: 'aviso-legal'}) }}" target="_blank" rel="noopener">aviso legal</a>
                            y la
                            <a href="{{ path('public_page_show', {slug: 'privacidad'}) }}" target="_blank" rel="noopener">política de privacidad</a>.
                        </span>
                    </label>
                    {% if contactFormErrors.privacy_accept is defined %}
                        <div class="field-error">{{ contactFormErrors.privacy_accept }}</div>
                    {% endif %}
                    <p class="contact-form-legal-note">
                        Los datos que envíes (nombre, email y mensaje) se utilizarán únicamente para responder a tu consulta.
                        No se cederán a terceros salvo obligación legal.
                    </p>
                </div>

                {% if usesRecaptcha %}
                    <div class="field contact-captcha">
                        <div class="g-recaptcha" data-sitekey="{{ recaptchaSiteKey }}"></div>
                        {% if contactFormErrors.captcha is defined %}
                            <div class="field-error">{{ contactFormErrors.captcha }}</div>
                        {% endif %}
                    </div>
                {% elseif captchaChallenge %}
                    <div class="field contact-captcha">
                        <label for="contact-captcha">Verificación anti-spam *</label>
                        <p class="captcha-question">¿Cuánto es {{ captchaChallenge.question }}?</p>
                        <input
                            type="text"
                            id="contact-captcha"
                            name="captcha_answer"
                            required
                            inputmode="numeric"
                            autocomplete="off"
                            class="{{ contactFormErrors.captcha is defined ? 'error' : '' }}"
                        >
                        {% if contactFormErrors.captcha is defined %}
                            <div class="field-error">{{ contactFormErrors.captcha }}</div>
                        {% endif %}
                    </div>
                {% endif %}

                <button type="submit" class="btn btn-primary contact-form-submit">Enviar mensaje</button>
            </form>
        </section>

        <div class="contact-info-card contact-info-card--inline">
            <h2 class="contact-info-title">Datos de contacto</h2>
            {% if footer.contactEmail %}
                <p class="contact-info-item">
                    <span class="contact-info-label">Email</span>
                    <a href="mailto:{{ footer.contactEmail }}">{{ footer.contactEmail }}</a>
                </p>
            {% endif %}
            {% if footer.contactPhone %}
                <p class="contact-info-item">
                    <span class="contact-info-label">Teléfono</span>
                    <a href="tel:{{ footer.contactPhone|replace({' ': ''}) }}">{{ footer.contactPhone }}</a>
                </p>
            {% endif %}
            {% if footer.contactAddress %}
                <p class="contact-info-item">
                    <span class="contact-info-label">Dirección</span>
                    <span>{{ footer.contactAddress }}</span>
                </p>
            {% endif %}
            {% if not footer.contactEmail and not footer.contactPhone and not footer.contactAddress %}
                <p class="contact-info-empty">Configura los datos de contacto en el administrador (Pie de página).</p>
            {% endif %}
            {% if not mailConfig.enabled %}
                <p class="contact-info-note">Activa SMTP en Admin → Configuración → Correo para enviar mensajes desde el formulario.</p>
            {% endif %}
        </div>

        {% include 'public/_partials/content_modules.html.twig' with { surface: 'contact' } %}
    </div>

    {% include 'public/archive/_sidebar.html.twig' %}
</div>
{% endblock %}

{% block extra_scripts %}
    {% if usesRecaptcha %}
        <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    {% endif %}
{% endblock %}
