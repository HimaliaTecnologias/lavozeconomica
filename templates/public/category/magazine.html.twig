{% include 'public/category/_header.html.twig' %}

{% if articles is empty %}
    <div class="category-empty-state">
        <p>No hay noticias publicadas en esta sección todavía.</p>
        <a href="{{ path('home') }}" class="category-empty-link">Volver a la portada</a>
    </div>
{% else %}
    {% if page == 1 %}
        {% set lead = articles[0] %}
        {% set secondaryBand = articles|length > 1 ? articles|slice(1, 3) : [] %}
        {% set rest = articles|length > 4 ? articles|slice(4) : [] %}

        {% include 'public/category/_lead_hero.html.twig' with {
            article: lead,
            sectionName: category.name,
        } only %}

        {% if secondaryBand is not empty %}
            <div class="portada-band portada-band--3 portada-band--magazine category-secondary-band">
                {% for article in secondaryBand %}
                    <article class="portada-band-card portada-band-card--featured">
                        <div class="portada-band-media-wrap">
                            <a href="{{ path('public_article_show', {slug: article.slug}) }}" class="portada-band-media">
                                {% set img = article_usable_featured(article) %}
                                {% if img %}
                                    {{ seo_article_image(img, article.title) }}
                                {% endif %}
                                <span class="portada-band-overlay" aria-hidden="true"></span>
                            </a>
                            <span class="cat-pill portada-band-cat-badge">{{ category.name }}</span>
                            <div class="portada-band-caption">
                                <h3 class="portada-band-title">
                                    <a href="{{ path('public_article_show', {slug: article.slug}) }}">{{ article.title }}</a>
                                </h3>
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}

        <div class="category-layout category-layout--magazine">
            <div class="category-main">
                {% if rest is not empty or totalPages > 1 %}
                    <header class="category-list-head" id="mas-en">
                        <h2 class="section-label">Más en {{ category.name }}</h2>
                    </header>
                {% endif %}
                {% if rest is not empty %}
                    <div class="more-stories category-more-stories">
                        {% for article in rest %}
                            <article class="more-story">
                                <a href="{{ path('public_article_show', {slug: article.slug}) }}" class="more-story-thumb">
                                    {% set img = article_usable_featured(article) %}
                                    {% if img %}
                                        {{ seo_article_image(img, article.title) }}
                                    {% else %}
                                        <span class="story-card-media-placeholder" aria-hidden="true">{{ site.name }}</span>
                                    {% endif %}
                                </a>
                                <div class="more-story-body">
                                    <h4><a href="{{ path('public_article_show', {slug: article.slug}) }}">{{ article.title }}</a></h4>
                                    <div class="meta-line">
                                        {% if article.publishedAt %}{{ article.publishedAt|date('d/m/Y H:i') }}{% endif %}
                                        · {{ article.viewCount }} lecturas
                                    </div>
                                    {% set excerpt = article.lead ?: article.subtitle %}
                                    {% if excerpt %}
                                        <p>{{ excerpt|length > 120 ? excerpt|slice(0, 117) ~ '…' : excerpt }}</p>
                                    {% endif %}
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                {% endif %}

                {% include 'public/_partials/pagination.html.twig' with {
                    route: 'public_category_show',
                    pagedRoute: 'public_category_show_paged',
                    routeParams: { slug: category.slug },
                    page: page,
                    totalPages: totalPages,
                    totalArticles: totalArticles,
                } %}
            </div>

            <aside class="article-sidebar category-sidebar">
                {% include 'public/_partials/ad_slot.html.twig' with { placement: 'category_sidebar', categoryId: category.id } only %}
                {% include 'public/_partials/ad_slot.html.twig' with { placement: 'sidebar_top', categoryId: category.id } only %}
                {% include 'public/_partials/popular_sidebar.html.twig' with {
                    articles: popularInCategory|default([]),
                    limit: layout.sidebarPopularCount|default(5),
                    categoryIds: categoryIds|default([]),
                    period: popularPeriod|default('week'),
                    title: 'Más vistas',
                } %}

                {% include 'public/_partials/ad_slot.html.twig' with { placement: 'sidebar_between_lists', categoryId: category.id } only %}

                {% include 'public/_partials/latest_sidebar.html.twig' with {
                    articles: latestOverall|default([]),
                    limit: layout.sidebarLatestCount|default(5),
                    title: 'Últimas del periódico',
                } %}
                {% include 'public/_partials/ad_slot.html.twig' with { placement: 'sidebar_bottom', categoryId: category.id } only %}
                {% include 'public/_partials/sidebar_links.html.twig' %}
            </aside>
        </div>
    {% else %}
        <div class="category-layout category-layout--magazine">
            <div class="category-main">
                <header class="category-list-head" id="mas-en">
                    <h2 class="section-label">Más en {{ category.name }}</h2>
                </header>
                <div class="more-stories category-more-stories">
                    {% for article in articles %}
                        <article class="more-story">
                            <a href="{{ path('public_article_show', {slug: article.slug}) }}" class="more-story-thumb">
                                {% set img = article_usable_featured(article) %}
                                {% if img %}
                                    {{ seo_article_image(img, article.title) }}
                                {% else %}
                                    <span class="story-card-media-placeholder" aria-hidden="true">{{ site.name }}</span>
                                {% endif %}
                            </a>
                            <div class="more-story-body">
                                <h4><a href="{{ path('public_article_show', {slug: article.slug}) }}">{{ article.title }}</a></h4>
                                <div class="meta-line">
                                    {% if article.publishedAt %}{{ article.publishedAt|date('d/m/Y H:i') }}{% endif %}
                                    · {{ article.viewCount }} lecturas
                                </div>
                                {% set excerpt = article.lead ?: article.subtitle %}
                                {% if excerpt %}
                                    <p>{{ excerpt|length > 120 ? excerpt|slice(0, 117) ~ '…' : excerpt }}</p>
                                {% endif %}
                            </div>
                        </article>
                    {% endfor %}
                </div>
                {% include 'public/_partials/pagination.html.twig' with {
                    route: 'public_category_show',
                    pagedRoute: 'public_category_show_paged',
                    routeParams: { slug: category.slug },
                    page: page,
                    totalPages: totalPages,
                    totalArticles: totalArticles,
                } %}
            </div>

            <aside class="article-sidebar category-sidebar">
                {% include 'public/_partials/ad_slot.html.twig' with { placement: 'category_sidebar', categoryId: category.id } only %}
                {% include 'public/_partials/ad_slot.html.twig' with { placement: 'sidebar_top', categoryId: category.id } only %}
                {% include 'public/_partials/popular_sidebar.html.twig' with {
                    articles: popularInCategory|default([]),
                    limit: layout.sidebarPopularCount|default(5),
                    categoryIds: categoryIds|default([]),
                    period: popularPeriod|default('week'),
                    title: 'Más vistas',
                } %}
                {% include 'public/_partials/ad_slot.html.twig' with { placement: 'sidebar_between_lists', categoryId: category.id } only %}
                {% include 'public/_partials/latest_sidebar.html.twig' with {
                    articles: latestOverall|default([]),
                    limit: layout.sidebarLatestCount|default(5),
                    title: 'Últimas del periódico',
                } %}
                {% include 'public/_partials/ad_slot.html.twig' with { placement: 'sidebar_bottom', categoryId: category.id } only %}
                {% include 'public/_partials/sidebar_links.html.twig' %}
            </aside>
        </div>
    {% endif %}
{% endif %}

{% include 'public/_partials/content_modules.html.twig' with { surface: 'category' } %}
