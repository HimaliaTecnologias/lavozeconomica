{% extends 'admin/layout.html.twig' %}

{% block title %}Módulos de contenido{% endblock %}

{% block extra_styles %}
<style>
    .cm-surface {
        border: 1px solid var(--admin-border);
        border-radius: 10px;
        background: #fff;
        margin-bottom: 1.25rem;
        overflow: hidden;
    }
    .cm-surface-head {
        padding: .9rem 1.1rem;
        background: #f8fafc;
        border-bottom: 1px solid var(--admin-border);
    }
    .cm-surface-head h2 {
        margin: 0;
        font-size: 1rem;
    }
    .cm-surface-head p {
        margin: .25rem 0 0;
        font-size: .82rem;
        color: var(--admin-muted);
    }
    .cm-table {
        width: 100%;
        border-collapse: collapse;
    }
    .cm-table th,
    .cm-table td {
        padding: .75rem 1rem;
        border-bottom: 1px solid var(--admin-border);
        text-align: left;
        vertical-align: middle;
        font-size: .9rem;
    }
    .cm-table th {
        font-size: .7rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: var(--admin-muted);
        background: #fbfcfd;
    }
    .cm-table tr:last-child td { border-bottom: none; }
    .cm-table tr.is-disabled { opacity: .55; }
    .cm-order {
        display: flex;
        gap: .25rem;
    }
    .cm-order button {
        width: 2rem;
        height: 2rem;
        border: 1px solid var(--admin-border);
        background: #fff;
        border-radius: 6px;
        cursor: pointer;
        font: inherit;
    }
    .cm-order button:hover { border-color: var(--admin-accent); }
    .cm-type-label { font-weight: 700; }
    .cm-type-desc {
        display: block;
        font-size: .78rem;
        color: var(--admin-muted);
        margin-top: .15rem;
    }
    .cm-table select,
    .cm-table input[type=number] {
        max-width: 16rem;
    }
    .cm-format-hint {
        display: block;
        font-size: .72rem;
        color: var(--admin-muted);
        margin-top: .25rem;
        line-height: 1.35;
        max-width: 16rem;
    }
</style>
{% endblock %}

{% block body %}
<h1>Módulos de contenido</h1>
<p class="hint">Define qué bloques aparecen <strong>después del contenido principal</strong> en cada tipo de página, su orden y el formato de visualización.</p>

{% include 'admin/settings/_subnav.html.twig' %}

<form method="post" action="{{ path('admin_settings_content_modules') }}" id="content-modules-form">
    <input type="hidden" name="_token" value="{{ csrf_token('settings_content_modules') }}">

    {% for surface in surfaces %}
        {% set items = config.allFor(surface) %}
        <section class="cm-surface" data-surface="{{ surface.value }}">
            <div class="cm-surface-head">
                <h2>{{ surface.label }}</h2>
                <p>{{ surface.description }}</p>
            </div>
            <table class="cm-table">
                <thead>
                    <tr>
                        <th style="width:4.5rem">Orden</th>
                        <th style="width:5rem">Activo</th>
                        <th>Módulo</th>
                        <th>Formato</th>
                        <th style="width:7rem">Cantidad</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in items %}
                        {% set type = item.type %}
                        {% set idx = loop.index0 %}
                        <tr class="{{ item.enabled ? '' : 'is-disabled' }}" data-module-row>
                            <td>
                                <input type="hidden" name="modules[{{ surface.value }}][{{ idx }}][type]" value="{{ type.value }}">
                                <input type="hidden" name="modules[{{ surface.value }}][{{ idx }}][sortOrder]" value="{{ item.sortOrder }}" data-sort-input>
                                <div class="cm-order">
                                    <button type="button" data-move="up" title="Subir">↑</button>
                                    <button type="button" data-move="down" title="Bajar">↓</button>
                                </div>
                            </td>
                            <td>
                                <label class="checkbox-row">
                                    <input type="checkbox" name="modules[{{ surface.value }}][{{ idx }}][enabled]" value="1" {{ item.enabled ? 'checked' : '' }} data-enabled>
                                </label>
                            </td>
                            <td>
                                <span class="cm-type-label">{{ type.label }}</span>
                                <span class="cm-type-desc">{{ type.description }}</span>
                            </td>
                            <td>
                                {% if type.allowedFormats|length == 1 %}
                                    <input type="hidden" name="modules[{{ surface.value }}][{{ idx }}][format]" value="{{ type.defaultFormat.value }}">
                                    <span>{{ type.defaultFormat.label }}</span>
                                {% else %}
                                    <select name="modules[{{ surface.value }}][{{ idx }}][format]" data-format-select>
                                        {% for format in type.allowedFormats %}
                                            <option value="{{ format.value }}"
                                                    data-hint="{{ format.description }}"
                                                    {{ item.format == format ? 'selected' : '' }}>{{ format.label }}</option>
                                        {% endfor %}
                                    </select>
                                    <span class="cm-format-hint" data-format-hint>{{ item.format.description }}</span>
                                {% endif %}                            </td>
                            <td>
                                {% if type.usesArticleList %}
                                    <input type="number" name="modules[{{ surface.value }}][{{ idx }}][count]" value="{{ item.count }}" min="2" max="12" step="1">
                                {% else %}
                                    <input type="hidden" name="modules[{{ surface.value }}][{{ idx }}][count]" value="0">
                                    <span class="cm-type-desc">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    {% endfor %}

    <div class="actions">
        <button type="submit" class="btn btn-primary">Guardar módulos</button>
    </div>
</form>
{% endblock %}

{% block extra_scripts %}
<script>
(() => {
    const form = document.getElementById('content-modules-form');
    if (!form) return;

    form.querySelectorAll('[data-surface]').forEach((surface) => {
        const tbody = surface.querySelector('tbody');
        if (!tbody) return;

        const reindex = () => {
            [...tbody.querySelectorAll('tr')].forEach((row, idx) => {
                const sort = row.querySelector('[data-sort-input]');
                if (sort) sort.value = String((idx + 1) * 10);
                row.querySelectorAll('input, select').forEach((el) => {
                    if (!el.name) return;
                    el.name = el.name.replace(/\[(\d+)\]/, `[${idx}]`);
                });
            });
        };

        tbody.addEventListener('click', (ev) => {
            const btn = ev.target.closest('[data-move]');
            if (!btn) return;
            const row = btn.closest('tr');
            if (!row) return;
            if (btn.dataset.move === 'up' && row.previousElementSibling) {
                tbody.insertBefore(row, row.previousElementSibling);
            }
            if (btn.dataset.move === 'down' && row.nextElementSibling) {
                tbody.insertBefore(row.nextElementSibling, row);
            }
            reindex();
        });

        tbody.addEventListener('change', (ev) => {
            const enabled = ev.target.closest('[data-enabled]');
            if (enabled) {
                enabled.closest('tr')?.classList.toggle('is-disabled', !enabled.checked);
            }
            const formatSelect = ev.target.closest('[data-format-select]');
            if (formatSelect) {
                const hint = formatSelect.parentElement?.querySelector('[data-format-hint]');
                const option = formatSelect.options[formatSelect.selectedIndex];
                if (hint && option) {
                    hint.textContent = option.dataset.hint || '';
                }
            }
        });
    });
})();
</script>
{% endblock %}
