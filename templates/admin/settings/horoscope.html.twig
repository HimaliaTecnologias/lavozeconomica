{% extends 'admin/layout.html.twig' %}

{% block title %}Horóscopo{% endblock %}

{% block extra_styles %}
<style>
    .settings-subnav { display: flex; gap: .5rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
    .settings-subnav a { padding: .4rem .75rem; border-radius: 6px; background: #edf2f7; text-decoration: none; color: var(--text); font-size: .9rem; font-weight: 600; }
    .settings-subnav a.active { background: var(--primary); color: #fff; }
    .inline-actions { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: 1rem; }
    .horoscope-preview { margin-top: 1.5rem; padding: 1rem; background: #f8fafc; border: 1px solid var(--border); border-radius: 10px; }
    .horoscope-preview article { margin-bottom: .75rem; padding-bottom: .75rem; border-bottom: 1px solid var(--border); }
    .horoscope-preview article:last-child { border-bottom: none; margin-bottom: 0; }
</style>
{% endblock %}

{% block body %}
<h1>Horóscopo</h1>
<p class="hint">Horóscopo diario en <code>/horoscopo</code> para los 12 signos.</p>
{% include 'admin/settings/_subnav.html.twig' %}

<form method="post" action="{{ path('admin_settings_horoscope') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('settings_horoscope') }}">

    <div class="checkbox-row field">
        <input type="checkbox" id="enabled" name="enabled" value="1" {{ (data.enabled|default(config.enabled)) ? 'checked' : '' }}>
        <label for="enabled">Mostrar horóscopo en el periódico</label>
    </div>

    <div class="checkbox-row field">
        <input type="checkbox" id="aiEnabled" name="aiEnabled" value="1" {{ (data.aiEnabled|default(config.aiEnabled)) ? 'checked' : '' }}>
        <label for="aiEnabled">Generar textos con IA (OpenAI)</label>
    </div>
    <p class="hint">La API key se configura en <a href="{{ path('admin_settings_ai') }}">Configuración → IA</a>.</p>
    {% if errors.openaiApiKey is defined %}<div class="error-msg">{{ errors.openaiApiKey }}</div>{% endif %}
        <p class="hint">Sin IA se usan textos predeterminados rotativos. Con IA se genera un horóscopo personalizado cada día.</p>
    </div>

    <div class="actions" style="margin-top:1rem">
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
</form>

<form method="post" action="{{ path('admin_settings_horoscope') }}" class="inline-actions">
    <input type="hidden" name="_token" value="{{ csrf_token('settings_horoscope') }}">
    <input type="hidden" name="action" value="refresh_board">
    <button type="submit" class="btn btn-secondary btn-sm">Regenerar horóscopo de hoy</button>
</form>

{% if board %}
    <div class="horoscope-preview">
        <p class="hint"><strong>Vista previa</strong> — {{ board.date|date('d/m/Y') }} · {{ board.generatedAt|date('H:i') }}</p>
        {% for sign in board.signs|slice(0, 4) %}
            <article>
                <strong>{{ sign.symbol }} {{ sign.name }}</strong> — {{ sign.headline }}
                <p style="margin:.25rem 0 0;font-size:.9rem">{{ sign.text }}</p>
            </article>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
