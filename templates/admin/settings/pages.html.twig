{% extends 'admin/layout.html.twig' %}

{% block title %}Páginas del periódico{% endblock %}

{% block extra_styles %}
<style>
    .settings-subnav { display: flex; gap: .5rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
    .settings-subnav a { padding: .4rem .75rem; border-radius: 6px; background: #edf2f7; text-decoration: none; color: var(--text); font-size: .9rem; font-weight: 600; }
    .settings-subnav a.active { background: var(--primary); color: #fff; }
    .page-editor { border: 1px solid var(--border); border-radius: 10px; padding: 1rem; margin-bottom: 1.25rem; background: #fafafa; }
    .page-editor h2 { margin: 0 0 .5rem; font-size: 1rem; }
    .page-editor .hint { margin-bottom: .75rem; }
    .page-editor .tox-tinymce {
        border-radius: 8px;
        border-color: var(--border);
        min-height: 420px;
    }
    .page-editor textarea.simple-wysiwyg {
        min-height: 420px;
        width: 100%;
        font-family: inherit;
        font-size: .95rem;
        line-height: 1.5;
        padding: .75rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        resize: vertical;
    }
    .page-preview-link { font-size: .85rem; }
</style>
{% endblock %}

{% block body %}
<h1>Páginas del periódico</h1>
<p class="hint">Contenido de Quiénes somos, Aviso legal, Privacidad, Cookies, Contacto y Anunciantes. Puedes dar formato, insertar tablas o pulsar <strong>Código fuente</strong> para editar el HTML.</p>
{% include 'admin/settings/_subnav.html.twig' %}

<form method="post" action="{{ path('admin_settings_pages') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('settings_pages') }}">

    {% for slug, definition in pages %}
        <div class="page-editor">
            <h2>{{ definition.title }}</h2>
            <p class="hint page-preview-link">
                URL pública: <a href="{{ path('public_page_show', {slug: slug}) }}" target="_blank" rel="noopener">/pagina/{{ slug }}</a>
            </p>
            <textarea
                id="page-{{ slug }}"
                name="{{ definition.settingKey }}"
                class="simple-wysiwyg"
                data-editor-preset="full"
                data-editor-height="520"
                rows="18"
            >{{ content[definition.settingKey]|default('') }}</textarea>
        </div>
    {% endfor %}

    <div class="actions">
        <a href="{{ path('admin_settings_index') }}" class="btn btn-secondary">Volver</a>
        <button type="submit" class="btn btn-primary">Guardar páginas</button>
    </div>
</form>
{% endblock %}

{% block extra_scripts %}
    {% include 'public/_partials/simple_wysiwyg_assets.html.twig' %}
{% endblock %}
