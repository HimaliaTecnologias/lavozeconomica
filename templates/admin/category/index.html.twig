{% extends 'admin/layout.html.twig' %}

{% block title %}Categorías{% endblock %}

{% block extra_styles %}
<style>
    .cat-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .75rem;
        margin-bottom: 1.15rem;
    }
    .cat-stat {
        background: #fff;
        border: 1px solid var(--admin-border);
        border-radius: var(--admin-radius-sm);
        padding: .85rem 1rem;
    }
    .cat-stat strong {
        display: block;
        font-size: 1.35rem;
        line-height: 1.1;
        letter-spacing: -.02em;
    }
    .cat-stat span {
        display: block;
        margin-top: .2rem;
        font-size: .8rem;
        color: var(--admin-muted);
    }
    .cat-tree-wrap {
        border: 1px solid var(--admin-border);
        border-radius: var(--admin-radius-sm);
        background: #fff;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    .cat-tree {
        min-width: 760px;
    }
    .cat-tree-head,
    .cat-row {
        display: grid;
        grid-template-columns:
            minmax(11rem, 2fr)
            minmax(7rem, 1fr)
            5.25rem
            4rem
            7rem
            14rem;
        gap: .65rem 1rem;
        align-items: center;
        padding: .75rem 1.1rem;
    }
    .cat-tree-head {
        background: #f8fafc;
        border-bottom: 1px solid var(--admin-border);
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: var(--admin-muted);
        position: sticky;
        top: 0;
        z-index: 1;
    }
    .cat-tree-head > span:nth-child(3),
    .cat-tree-head > span:nth-child(4),
    .cat-tree-head > span:nth-child(5) {
        text-align: center;
    }
    .cat-row {
        border-bottom: 1px solid var(--admin-border);
        min-height: 3.5rem;
    }
    .cat-row:last-child { border-bottom: none; }
    .cat-row:hover { background: #f8fafc; }
    .cat-row--depth-1 { background: #fbfcfd; }
    .cat-row--depth-2 { background: #f8fafc; }
    .cat-name {
        display: flex;
        align-items: flex-start;
        gap: .55rem;
        min-width: 0;
    }
    .cat-indent {
        flex-shrink: 0;
        color: var(--admin-muted);
        font-size: .85rem;
        line-height: 1.4;
        user-select: none;
    }
    .cat-name-text { min-width: 0; }
    .cat-name-text strong {
        display: block;
        font-size: .92rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .cat-name-text .cat-path {
        margin-top: .12rem;
        font-size: .75rem;
        color: var(--admin-muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .cat-slug {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: .78rem;
        color: #475569;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .cat-num {
        font-variant-numeric: tabular-nums;
        font-weight: 600;
        font-size: .9rem;
        text-align: center;
    }
    .cat-num--muted { color: var(--admin-muted); font-weight: 500; }
    .cat-menu-cell {
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .cat-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        min-width: 5.5rem;
        max-width: 100%;
        padding: .28rem .7rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .03em;
        line-height: 1.2;
        white-space: nowrap;
        text-align: center;
    }
    .cat-badge--on {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }
    .cat-badge--off {
        background: #f1f5f9;
        color: #64748b;
        border: 1px solid #e2e8f0;
    }
    .cat-actions {
        display: flex;
        gap: .28rem;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: nowrap;
    }
    .cat-actions form { margin: 0; display: inline-flex; }
    .cat-icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        padding: 0;
        border-radius: 7px;
        border: 1px solid var(--admin-border);
        background: #fff;
        color: #334155;
        cursor: pointer;
        text-decoration: none;
        flex-shrink: 0;
        transition: background .12s, border-color .12s, color .12s;
    }
    .cat-icon-btn:hover {
        background: #f8fafc;
        border-color: #94a3b8;
        color: #0f172a;
    }
    .cat-icon-btn--accent {
        color: var(--admin-accent);
        border-color: color-mix(in srgb, var(--admin-accent) 35%, var(--admin-border));
    }
    .cat-icon-btn--accent:hover {
        background: color-mix(in srgb, var(--admin-accent) 10%, #fff);
        border-color: var(--admin-accent);
    }
    .cat-icon-btn--danger {
        color: #b91c1c;
        border-color: color-mix(in srgb, #b91c1c 28%, var(--admin-border));
    }
    .cat-icon-btn--danger:hover {
        background: #fef2f2;
        border-color: #b91c1c;
    }
    .cat-icon-btn:disabled,
    .cat-icon-btn.is-disabled {
        opacity: .35;
        cursor: not-allowed;
        pointer-events: none;
    }
    .cat-icon-btn svg {
        width: 1rem;
        height: 1rem;
        display: block;
    }
    .cat-empty {
        margin-top: .25rem;
        padding: 2rem 1.25rem;
        text-align: center;
        border: 1px dashed var(--admin-border);
        border-radius: var(--admin-radius-sm);
        background: #fff;
    }
    .cat-empty p { margin: 0 0 .85rem; color: var(--admin-muted); }
    @media (max-width: 960px) {
        .cat-stats { grid-template-columns: 1fr; }
        .cat-tree { min-width: 0; }
        .cat-tree-head { display: none; }
        .cat-row {
            grid-template-columns: 1fr;
            gap: .55rem;
            padding: .95rem 1rem;
            min-width: 0;
        }
        .cat-num,
        .cat-menu-cell { justify-content: flex-start; text-align: left; }
        .cat-actions { justify-content: flex-start; flex-wrap: wrap; }
        .cat-slug::before { content: 'Slug: '; color: var(--admin-muted); font-family: inherit; }
        .cat-num[data-label]::before {
            content: attr(data-label) ': ';
            color: var(--admin-muted);
            font-weight: 500;
        }
        .cat-menu-cell[data-label]::before {
            content: attr(data-label) ': ';
            color: var(--admin-muted);
            font-size: .8rem;
            font-weight: 500;
            margin-right: .35rem;
        }
    }
</style>
{% endblock %}

{% block body %}
{% set headerActions %}
    <a href="{{ path('admin_categories_new') }}" class="btn btn-primary btn-sm">Nueva categoría</a>
{% endset %}

{% include 'admin/_page_header.html.twig' with {
    title: 'Categorías',
    subtitle: 'Secciones del periódico: menú, listados y organización de noticias.',
    breadcrumbs: [
        { label: 'Panel', url: path('admin_dashboard') },
        { label: 'Categorías' },
    ],
    actions: headerActions
} only %}

<div class="cat-stats">
    <div class="cat-stat">
        <strong>{{ totalCategories }}</strong>
        <span>categorías en total</span>
    </div>
    <div class="cat-stat">
        <strong>{{ categoryTree|length }}</strong>
        <span>secciones principales</span>
    </div>
    <div class="cat-stat">
        <strong>{{ publishedTotal }}</strong>
        <span>noticias publicadas asignadas</span>
    </div>
</div>

{% if categoryTree is empty %}
    <div class="cat-empty">
        <p>Aún no hay categorías. Crea la primera sección para organizar las noticias.</p>
        <a href="{{ path('admin_categories_new') }}" class="btn btn-primary">Nueva categoría</a>
    </div>
{% else %}
    <div class="cat-tree-wrap">
    <div class="cat-tree">
        <div class="cat-tree-head" aria-hidden="true">
            <span>Nombre</span>
            <span>Slug</span>
            <span>Publicadas</span>
            <span>Orden</span>
            <span>Menú</span>
            <span></span>
        </div>

        {% macro cat_actions(category, canAddChild, canMoveUp, canMoveDown) %}
            <div class="cat-actions">
                <form method="post" action="{{ path('admin_categories_move', {id: category.id, direction: 'up'}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('move_category' ~ category.id) }}">
                    <button type="submit"
                            class="cat-icon-btn{{ not canMoveUp ? ' is-disabled' : '' }}"
                            {% if not canMoveUp %}disabled{% endif %}
                            title="Subir en el menú"
                            aria-label="Subir {{ category.name }} en el menú">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
                    </button>
                </form>
                <form method="post" action="{{ path('admin_categories_move', {id: category.id, direction: 'down'}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('move_category' ~ category.id) }}">
                    <button type="submit"
                            class="cat-icon-btn{{ not canMoveDown ? ' is-disabled' : '' }}"
                            {% if not canMoveDown %}disabled{% endif %}
                            title="Bajar en el menú"
                            aria-label="Bajar {{ category.name }} en el menú">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
                    </button>
                </form>
                {% if canAddChild %}
                    <a href="{{ path('admin_categories_new', {parent: category.id}) }}"
                       class="cat-icon-btn cat-icon-btn--accent"
                       title="Añadir subcategoría"
                       aria-label="Añadir subcategoría a {{ category.name }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                    </a>
                {% endif %}
                <a href="{{ path('public_category_show', {slug: category.slug}) }}"
                   class="cat-icon-btn" target="_blank" rel="noopener"
                   title="Ver en la web" aria-label="Ver {{ category.name }} en la web">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
                <a href="{{ path('admin_categories_edit', {id: category.id}) }}"
                   class="cat-icon-btn" title="Editar" aria-label="Editar {{ category.name }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                </a>
                <form method="post" action="{{ path('admin_categories_delete', {id: category.id}) }}" onsubmit="return confirm('¿Eliminar esta categoría?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_category' ~ category.id) }}">
                    <button type="submit" class="cat-icon-btn cat-icon-btn--danger" title="Eliminar" aria-label="Eliminar {{ category.name }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                    </button>
                </form>
            </div>
        {% endmacro %}

        {% macro cat_row(category, depth, pathLabel, displayCounts, canMoveUp, canMoveDown) %}
            {% set count = displayCounts[category.id]|default(0) %}
            <div class="cat-row cat-row--depth-{{ depth }}">
                <div class="cat-name">
                    {% if depth > 0 %}
                        <span class="cat-indent" aria-hidden="true">{{ depth == 1 ? '↳' : '↳↳' }}</span>
                    {% endif %}
                    <div class="cat-name-text">
                        <strong title="{{ category.name }}">{{ category.name }}</strong>
                        {% if pathLabel %}
                            <div class="cat-path">{{ pathLabel }}</div>
                        {% elseif category.description %}
                            <div class="cat-path">{{ category.description|slice(0, 72) }}{% if category.description|length > 72 %}…{% endif %}</div>
                        {% endif %}
                    </div>
                </div>
                <div class="cat-slug" title="{{ category.slug }}">{{ category.slug }}</div>
                <div class="cat-num {{ count == 0 ? 'cat-num--muted' : '' }}" data-label="Publicadas">{{ count }}</div>
                <div class="cat-num" data-label="Orden">{{ category.sortOrder }}</div>
                <div class="cat-menu-cell" data-label="Menú">
                    <span class="cat-badge {{ category.showInNav ? 'cat-badge--on' : 'cat-badge--off' }}">
                        {{ category.showInNav ? 'Visible' : 'Oculta' }}
                    </span>
                </div>
                {{ _self.cat_actions(category, depth < 2, canMoveUp, canMoveDown) }}
            </div>
        {% endmacro %}

        {% import _self as ui %}
        {% for root in categoryTree %}
            {{ ui.cat_row(root, 0, null, displayCounts, not loop.first, not loop.last) }}
            {% for child in root.children %}
                {{ ui.cat_row(child, 1, root.name, displayCounts, not loop.first, not loop.last) }}
                {% for grand in child.children %}
                    {{ ui.cat_row(grand, 2, root.name ~ ' › ' ~ child.name, displayCounts, not loop.first, not loop.last) }}
                {% endfor %}
            {% endfor %}
        {% endfor %}
    </div>
    </div>
{% endif %}
{% endblock %}
