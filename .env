# Alineado con Territorio Madrid (APP_ENV=dev). El noindex está off en framework.yaml.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=bc84ae27e48600c0da1a252e76e2fb4c

# URL pública (canónicas, sitemap, RSS). Con www, como en Plesk.
PUBLIC_BASE_URL=https://www.lavozeconomica.com
DEFAULT_URI=https://www.lavozeconomica.com
DEFAULT_SITE_CODE=lavoz-economica

# Puertos en el host (Plesk hace proxy a APP_PORT).
APP_PORT=19140
MYSQL_PORT=3319
REDIS_PORT=6392

PLATFORM_DATABASE_URL="mysql://mymedia:mymedia_secret@mysql:3306/mymedia_platform?serverVersion=11.4&charset=utf8mb4"
SITE_DATABASE_URL="mysql://mymedia:mymedia_secret@mysql:3306/mymedia_site_demo?serverVersion=11.4&charset=utf8mb4"

# --- Redis (recomendado en Docker/VPS) ---
# Cache tag-aware + colas Messenger. Requiere proceso worker:
#   php bin/console messenger:consume async_high async_low -vv
CACHE_APP_ADAPTER=cache.adapter.redis_tag_aware
REDIS_URL=redis://redis:6379
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages

# --- Sin Redis (hosting compartido / sin cola) ---
# Descomenta y comenta el bloque Redis de arriba.
# La caché usa disco (var/share/pools); los mensajes Messenger se ejecutan
# en la misma petición HTTP (no hace falta worker).
# CACHE_APP_ADAPTER=cache.adapter.filesystem_tag_aware
# MESSENGER_TRANSPORT_DSN=sync://
# REDIS_URL=   # opcional; se ignora si el adapter no es Redis

# URL opcional de servicio externo de mejora IA (Real-ESRGAN, etc.)
IMAGE_ENHANCER_URL=

# OpenAI (pronóstico editorial en /tiempo; opcional si se configura por sitio en admin)
OPENAI_API_KEY=

# Google reCAPTCHA v2 (opcional; sin claves se usa captcha matemático en el registro)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Clave obligatoria para POST /api/v1/ingest/himtecmedia (cabecera X-API-Key o Authorization: Bearer)
INGEST_API_KEY=

# Correo (null://null en dev; smtp://user:pass@smtp.example.com:587 en producción)
MAILER_DSN=null://null
NEWSLETTER_FROM=

PROVISION_DB_HOST=mysql
PROVISION_DB_USER=mymedia
PROVISION_DB_PASSWORD=mymedia_secret
PROVISION_DB_ROOT_USER=root
PROVISION_DB_ROOT_PASSWORD=root_secret
